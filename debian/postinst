#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    mkdir -p /var/lib/ubuntuguard/reports \
             /var/lib/ubuntuguard/backups \
             /var/log/ubuntuguard
    # Drop stale bytecode from a previous version so upgrades take effect.
    rm -rf /usr/lib/python3*/dist-packages/ubuntuguard/__pycache__ \
           /usr/lib/python3/dist-packages/ubuntuguard/__pycache__ 2>/dev/null || true
    systemctl daemon-reload || true
    systemctl enable ubuntuguard-audit.timer ubuntuguard-monitor.timer || true
    systemctl start ubuntuguard-audit.timer ubuntuguard-monitor.timer || true
fi

#DEBHELPER#

exit 0
